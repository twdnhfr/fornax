{
  "name": "fornax",
  "version": "1.1.0",
  "description": "Agent-first CLI to provision and run PHP/Laravel servers — a self-hosted alternative to Laravel Forge",
  "type": "module",
  "license": "MIT",
  "bin": {
    "fornax": "src/cli.ts"
  },
  "scripts": {
    "fornax": "bun src/cli.ts",
    "test": "bun test test/unit",
    "test:int": "bun test test/integration --timeout 1800000",
    "typecheck": "tsc --noEmit",
    "ui:css": "tailwindcss -i src/ui/input.css -o src/ui/style.css --minify",
    "build": "bash scripts/build.sh",
    "docs": "bun scripts/config-reference.ts",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
